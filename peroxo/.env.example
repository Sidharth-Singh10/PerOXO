# Copy to .env for local development. Never commit the real file.

PER_OXO_SERVICE_ADDR=0.0.0.0:3000
# Metrics listen on a separate, internal listener.
PER_OXO_METRICS_ADDR=127.0.0.1:9100
RUST_LOG=debug

CHAT_SERVICE_ADDR=http://127.0.0.1:50052
AUTH_SERVICE_ADDR=http://127.0.0.1:50051

# Internal gRPC bearer secret shared with auth-service and chat-service.
GRPC_SHARED_SECRET=

# Local-only escape hatch: allow startup without GRPC_SHARED_SECRET.
# ALLOW_INSECURE_GRPC=1
