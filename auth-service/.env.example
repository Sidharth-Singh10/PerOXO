# Copy to .env for local development. Never commit the real file.

# Postgres connection string (includes the password).
DATABASE_URL=postgresql://user:password@host:5432/database

# Comma-separated HTTPS origins allowed to call this API. No wildcard.
ALLOWED_ORIGINS=https://docs.mutref.tech

# Google OAuth client id used to verify ID tokens for tenant creation.
GOOGLE_CLIENT_ID=

# Internal gRPC bearer secret shared with peroxo and chat-service.
# Generate with: openssl rand -hex 32
GRPC_SHARED_SECRET=

# Local-only escape hatch: allow startup without GRPC_SHARED_SECRET.
# ALLOW_INSECURE_GRPC=1

REDIS_URL=redis://127.0.0.1:6379
GRPC_ADDR=127.0.0.1:50051

# Set to 1 only when a trusted reverse proxy overwrites X-Forwarded-For.
# Otherwise the header is spoofable and must not key the rate limiter.
# TRUST_PROXY_HEADERS=1
