# Copy to .env for local development. Never commit the real file.

SCYLLA_HOST=127.0.0.1:9042
GRPC_ADDR=127.0.0.1:50052
RUST_LOG=info

# Single-node dev cluster; use LocalQuorum and RF >= 3 in production.
SCYLLA_CONSISTENCY=One
SCYLLA_REPLICATION_FACTOR=1

# Internal gRPC bearer secret shared with auth-service and peroxo.
GRPC_SHARED_SECRET=

# Local-only escape hatch: allow startup without GRPC_SHARED_SECRET.
# ALLOW_INSECURE_GRPC=1
